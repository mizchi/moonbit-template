# direnv auto-bootstrap for this repo. Re-entering the directory is
# cheap — every block below is idempotent.
#
# After cloning: `direnv allow` to enable. Without direnv, follow the
# manual two-step in ~/.claude/CLAUDE.md "プロジェクト初期化".

# Layer 1: dev environment (devbox if present, else flake.nix)
if [ -f devbox.json ]; then
  eval "$(devbox generate direnv --print-envrc)"
elif [ -f flake.nix ]; then
  use flake
fi

# Layer 2: project skills via APM (one-time)
if [ -f apm.yml ] && [ ! -d apm_modules ]; then
  echo "[direnv] apm install..."
  apm install
fi

# Layer 3: pre-commit hook via prek (or pre-commit) (one-time)
if [ -f .pre-commit-config.yaml ] && [ ! -f .git/hooks/pre-commit ]; then
  echo "[direnv] installing pre-commit hook..."
  if command -v prek >/dev/null 2>&1; then
    prek install
  elif command -v pre-commit >/dev/null 2>&1; then
    pre-commit install
  else
    echo "[direnv] WARNING: neither prek nor pre-commit found on PATH; hook NOT installed"
  fi
fi
